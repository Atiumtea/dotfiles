/**
 * Compact Hyproled menu.
 * Uses the same generated Stylix palette as the Super+R launcher.
 */
configuration {
    modi: "dmenu";
    show-icons: false;
}

@import "config.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 360px;
    x-offset: 0px;
    y-offset: 0px;

    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-radius: 6px;
    border-color: @normal-foreground;
    background-color: black / 35%;
}

mainbox {
    spacing: 8px;
    margin: 0px;
    padding: 10px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 10px;
    margin: 0px;
    padding: 8px 10px;
    border: 1px solid;
    border-radius: 4px;
    border-color: @normal-foreground;
    background-color: transparent;
    text-color: @normal-text;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: inherit;
    text-color: inherit;
}

entry {
    background-color: inherit;
    text-color: inherit;
    placeholder: "Select an option";
    placeholder-color: inherit;
}

listview {
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: true;

    spacing: 2px;
    margin: 0px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
}

scrollbar {
    enabled: false;
    width: 0px;
    handle-width: 0px;
}

element {
    spacing: 8px;
    margin: 0px;
    padding: 7px 10px;
    border: 0px solid;
    border-radius: 4px;
    background-color: transparent;
    text-color: @normal-text;
    orientation: horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color: @normal-text;
}

element selected.normal {
    border: 1px solid;
    border-radius: 4px;
    border-color: @selected-active-foreground;
    background-color: black / 20%;
    text-color: @active-text;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    vertical-align: 0.5;
}
